{{!< layout}}
<script type="text/javascript">
    window.MC_BASE_URL = "{{MC_BASE_URL}}";
    const MC_BASE_URL = "{{MC_BASE_URL}}";
    const JWTToken = "{{token}}";
    const loginState = "{{loginState}}";
    const loginURL = "{{{loginURL}}}";
    const mcAccessToken = "{{mcAccessToken}}";
    const loggedUser = {{{user}}};
</script>
<link rel="stylesheet" href="/css/editor.css" type="text/css" />
<link rel="stylesheet" href="/dist/svelte/editor-styles.css" type="text/css" />
<script src="/js/editor/editor.js" type="module"></script>
<div class="mc-legacy-banner" id="mc-legacy-banner" role="status">
    <strong>Update available:</strong> you're using the old version of Mermaid Chart for Confluence.
    To update, go to <strong>Apps &rsaquo; Manage apps</strong> and click <strong>Update</strong>, or ask your Confluence admin.
    This version may stop working after January 2027.
</div>
<script type="text/javascript">
    // The editor's screens are pinned to the top of the page; move them below the banner,
    // whose height changes when its text wraps.
    (() => {
        const banner = document.getElementById('mc-legacy-banner');
        const setBannerHeight = () =>
            document.documentElement.style.setProperty('--mc-banner-height', `${banner.offsetHeight}px`);
        setBannerHeight();
        new ResizeObserver(setBannerHeight).observe(banner);
    })();
</script>
<div class="ac-content" id="editor-content"></div>
