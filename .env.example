# Optional. api/index.js keeps these hardcoded when the variables are unset.
MC_BASE_URL=https://test.mermaidchart.com
# Public URL of this server; Mermaid Chart redirects here after sign-in (/callback).
# Local dev: your ngrok domain from credentials.json, e.g. https://your-reserved-name.ngrok-free.dev
LOCAL_BASE_URL=https://confluence.mermaidchart.com
PORT=3010
MC_CLIENT_ID=

# Sign-in state. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
